// KEDA v2.20.1's own go.mod uses these replace directives to pin
// k8s.io/client-go and controller-runtime to versions its code
// actually builds against. `replace` in a dependency's go.mod is
// ignored by consumers, so we duplicate the pins here — otherwise
// KEDA's require lines drag in k8s.io/client-go v0.36.0 whose
// ResourceEventHandlerRegistration interface controller-runtime
// v0.23.3 doesn't implement (missing HasSyncedChecker).
replace k8s.io/client-go => k8s.io/client-go v0.35.5

replace sigs.k8s.io/controller-runtime => sigs.k8s.io/controller-runtime v0.23.3

replace k8s.io/api => k8s.io/api v0.35.5

replace k8s.io/apimachinery => k8s.io/apimachinery v0.35.5

replace k8s.io/apiextensions-apiserver => k8s.io/apiextensions-apiserver v0.35.5

replace k8s.io/apiserver => k8s.io/apiserver v0.35.5

replace k8s.io/component-base => k8s.io/component-base v0.35.5

replace k8s.io/kms => k8s.io/kms v0.35.5
